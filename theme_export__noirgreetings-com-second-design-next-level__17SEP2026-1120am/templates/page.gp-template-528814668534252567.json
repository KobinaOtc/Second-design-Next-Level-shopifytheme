{"sections":{"gp_section_528814668567806999":{"settings":{"checksum":"2c3944f457684e264da3164976a6b42dcf1b1f239d5eb52e2610e232c40729b4_1_1_0_0__1","gg8L581SmZA_background_desktop_image_src":"https://cdn.shopify.com/s/files/1/0648/4973/9958/files/gempages_528582213629903824-e960af66-0796-43a3-855e-ce20b5e5ffcf.jpg","gg8L581SmZA_background_desktop_video":"https://www.youtube.com/watch?v=cyzh48XRS4M","gg8L581SmZA_background_desktop_videoHtml5":"https://media.w3.org/2010/05/sintel/trailer.mp4","gg8L581SmZA_background_mobile_image_src":"https://cdn.shopify.com/s/files/1/0648/4973/9958/files/gempages_528582213629903824-98b4a4a5-2943-46e8-b25f-4e8f9a78bece.jpg","gg8L581SmZA_background_mobile_video":"https://www.youtube.com/watch?v=cyzh48XRS4M","gg8L581SmZA_background_mobile_videoHtml5":"https://media.w3.org/2010/05/sintel/trailer.mp4","ggo0VVvfTdB_text":"Noir Nectar","ggpRD2XrhJn_text":"\u003cp\u003eComing Soon....\u003c/p\u003e","section_preload":"true"},"type":"gp-section-528814668567806999"},"gp_section_528814668601361431":{"settings":{"checksum":"ff3068699fe2081da16a3dfe5ffc7a47c4b70322da37f17a5409fdf6290e92a9_1_1_0_0__1","gg55Anm7ovL_text":"Our Story","ggAsstCGItk_text":"\u003cp\u003eOur journey began with a love for both the timeless elegance of black and the sweet allure of nectar. Noir, symbolizing sophistication and depth, and Nectar, representing sweetness and life, together embody the spirit of our creations. We blend classic aesthetics with contemporary designs to offer you greeting cards that are not just pieces of paper, but keepsakes that will be treasured for years to come.\u003c/p\u003e"},"type":"gp-section-528814668601361431"},"gp_section_528814668601426967":{"settings":{"checksum":"a22f14cf38f4f366e5c4338705e0914ca4e74fa1386092e30bbba1798a2a83a8_1_1_0_0__1","gg9ALe5xiq__text":"\u003cp\u003eAt Noir Nectar, we believe in the magic of words and the beauty of art, with a mission to uplift and celebrate Black women. Our passion lies in creating exquisite greeting cards that capture the essence of life's most precious moments, with a special focus on honoring the strength, beauty, and grace of Black women. Whether it’s a heartfelt birthday wish, a romantic anniversary note, or a simple thank you, our cards are designed to express the emotions that words alone cannot convey.\u003c/p\u003e","ggCEqLBImuM_text":"\u003cp\u003eKey Points:\u003c/p\u003e","ggDo3rwK7nS_text":"\u003cp\u003eElegant \u0026amp; Modern Designs: Our cards blend timeless elegance with contemporary style, creating cherished keepsakes.\u003c/p\u003e","ggQyeIc4-U7_text":"\u003cp\u003e98%\u003c/p\u003e","ggRYwoOxlj-_text":"\u003cp\u003eCelebrating Black Women: Noir Nectar Greeting Cards honors the strength and beauty of Black women with exquisite, heartfelt cards.\u003c/p\u003e","gg_QmOprt2N_text":"Noir Nectar Greeting Cards and Heirlooms","gghHkmNTffC_text":"\u003cp\u003e94%\u003c/p\u003e","ggl_qRgLOmQ_text":"\u003cp\u003e97%\u003c/p\u003e","ggmNPX39Uch_text":"\u003cp\u003eThoughtfully Crafted: Each card is crafted with premium materials and unique designs by our talented team, many of whom are Black women.\u003c/p\u003e","ggq3LdqgsRJ_srcSet_desktop_src":"https://gempages-demo.myshopify.com/cdn/shop/t/1/assets/495611768014373769-7ae9f04d-1a3a-437c-8cf7-ed3176fe287e.png?v=35749706828471631571705567077","ggq3LdqgsRJ_srcSet_tablet_src":"https://noirgreetings.com/cdn/shop/files/model_mockups__48_7e081895-0b5a-4d32-bdfc-850f7d4686cb.png?v=1722839689\u0026width=720","ggsEo3TmG87_srcSet_desktop_src":"https://noirgreetings.com/cdn/shop/files/model_mockups__48_7e081895-0b5a-4d32-bdfc-850f7d4686cb.png?v=1722839689\u0026width=720"},"type":"gp-section-528814668601426967"},"gp_section_528814668618138647":{"settings":{"checksum":"9907f50db3044e6f579147867d9ff0d5bc9138d97b5adf329de23ff0be1473c7_1_1_0_0__1","ggFORjM_Rkl_text":"\u003cp\u003eFrom Our Heart to Yours, Cards That Capture Every Emotion\u003c/p\u003e","ggTwWWZtYbP_text":"\u003cp\u003eUnveil the Magic of Greeting Cards Designed for You\u003c/p\u003e","ggXArp7z6B5_text":"\u003cp\u003eUnveil the Magic of Greeting Cards Designed for You\u003c/p\u003e","ggmY573ogC1_text":"\u003cp\u003eFrom Our Heart to Yours, Cards That Capture Every Emotion\u003c/p\u003e"},"type":"gp-section-528814668618138647"},"gp_section_528814668634915863":{"settings":{"checksum":"9355d51ab68165b1f126dc3542fac1513f3ebecbffa89789ffccb515279569f9_1_1_0_0__1","gg-H2nxCJ-6_text":"Hear from Our Customers","gg69eoqWpAp_text":"\u003cp\u003e\u003cspan style=\"color:#242424;\"\u003e\u003cstrong\u003eEmily R.\u003c/strong\u003e\u003c/span\u003e | Customer \u0026nbsp;\u003c/p\u003e","ggAy8aOH7ir_childItem_0":"\u003cp\u003eVerified Buyer\u003c/p\u003e","ggBnxzwElPT_text":"\u003cp\u003eFinding Noir Nectar was like discovering a hidden gem. The quality of the cards is unmatched, and the attention to detail is incredible. I especially appreciate the representation and empowerment of Black women in their designs. These cards are more than just stationery; they are keepsakes\u003c/p\u003e","ggFQw0X-7He_childItem_0":"\u003cp\u003eVerified Buyer\u003c/p\u003e","ggTkilIYnAv_text":"\u003cp\u003e\u003cspan style=\"color:#242424;\"\u003e\u003cstrong\u003eSamantha L.\u003c/strong\u003e\u003c/span\u003e| Customer \u0026nbsp;\u003c/p\u003e","ggUj4pQRCNV_text":"\u003cp\u003e\u003cspan style=\"color:#242424;\"\u003e\u003cstrong\u003eMichael D.\u003c/strong\u003e\u003c/span\u003e | Customer \u0026nbsp;\u003c/p\u003e","ggXF8mitGYc_childItem_0":"\u003cp\u003eVerified Buyer\u003c/p\u003e","ggXvOxkwrf6_text":"\u003cp\u003eI’ve never been so moved by a greeting card before. Noir Nectar’s cards resonate deeply with me and those I send them to. They perfectly capture the emotions I want to convey, and their dedication to celebrating Black women is truly inspiring.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e","ggf7M9jd0Gf_childItem_0":"\u003cp\u003eVerified Buyer\u003c/p\u003e","ggivC8VHjiu_text":"\u003cp\u003eNoir Nectar cards are simply beautiful! Every card I’ve sent has brought tears of joy to my friends and family. The designs are stunning, and the messages are heartfelt. I love how they celebrate Black women with such grace and elegance.\"\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e","ggsEvFm3qGa_text":"\u003cp\u003e\u003cspan style=\"color:#242424;\"\u003e\u003cstrong\u003eAngela M.\u003c/strong\u003e\u003c/span\u003e | Customer \u0026nbsp;\u003c/p\u003e","ggwQ7v5Tutr_text":"\u003cp\u003eEvery Noir Nectar card I’ve purchased has been a work of art. The combination of sophisticated design and meaningful messages makes each card special. I’m proud to support a company that uplifts and honors Black women in such a beautiful way.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e"},"type":"gp-section-528814668634915863"},"gp_section_528814668651693079":{"settings":{"checksum":"ca51e4b0ef0727dda470d42c581d8cc9f6c1f6835b29b7d820b85efff801512d_1_1_0_0__1","gg0Iu0RbPqP_alt":"Alt Image","gg0Iu0RbPqP_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0648/4973/9958/collections/Greeting_Card-3.jpg?v=1724327804","gg0Iu0RbPqP_title":"Image Title","gg7P43WJuc9_text":"Mugs","ggD1a_RZdTh_alt":"Alt Image","ggD1a_RZdTh_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0648/4973/9958/files/model_mockups_4_1.png?v=1722804396","ggD1a_RZdTh_title":"Image Title","ggPT9-HSeNG_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0648/4973/9958/files/image.png?v=1724409501","ggTcShgC5wC_alt":"Alt Image","ggTcShgC5wC_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0648/4973/9958/files/download_10.png?v=1724410096","ggTcShgC5wC_title":"Image Title","ggatWwoTTAH_alt":"Alt Image","ggatWwoTTAH_srcSet_desktop_src":"https://cdn.shopify.com/s/files/1/0648/4973/9958/files/Greeting_Card-5_aff03bda-9a6d-4c98-ae59-c53ca76645bf.jpg?v=1724326112","ggatWwoTTAH_title":"Image Title","gghwbVyaSYB_text":"T-Shirts","ggsDfIRt7lP_text":"Card","ggtHdin3l0__text":"Jewelry"},"type":"gp-section-528814668651693079