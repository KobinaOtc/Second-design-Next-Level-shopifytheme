<style>
  .feature-row-section {
    background-color: {{ section.settings.bg_color }};
    padding: 50px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
  .feature-row-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .feature-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }
  .feature-item {
    flex: 1;
    min-width: 200px;
    text-align: center;
    padding: 20px 30px;
    position: relative;
  }
  /* Vertical separator line between columns */
  .feature-item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 60%;
    background-color: {{ section.settings.separator_color }};
  }
  .feature-icon {
    width: {{ section.settings.icon_width }}px;
    height: {{ section.settings.icon_width }}px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.icon_color }};
  }
  .feature-icon svg {
    width: 100%;
    height: 100%;
  }
  .feature-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .feature-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 600;
    margin-bottom: 12px;
    color: {{ section.settings.title_color }};
    letter-spacing: 0.5px;
  }
  .feature-description {
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
    margin-bottom: 8px;
  }
  .feature-link {
    display: inline-block;
    margin-top: 8px;
    font-size: {{ section.settings.link_size }}px;
    font-weight: 500;
    color: {{ section.settings.link_color }};
    text-decoration: none;
    border-bottom: 1px solid {{ section.settings.link_color }};
    transition: opacity 0.2s;
  }
  .feature-link:hover {
    opacity: 0.7;
  }
  @media (max-width: 768px) {
    .feature-item {
      min-width: 100%;
      padding: 20px 15px;
    }
    .feature-item:not(:last-child)::after {
      display: none;
    }
  }
</style>

<div class="feature-row-section">
  <div class="feature-row-container">
    <div class="feature-grid">
      {% for block in section.blocks %}
        <div class="feature-item" {{ block.shopify_attributes }}>
          <div class="feature-icon">
            {% if block.settings.icon_type == 'image' and block.settings.icon_image != blank %}
              <img src="{{ block.settings.icon_image | img_url: 'master' }}" alt="{{ block.settings.title }}" loading="lazy">
            {% elsif block.settings.icon_type == 'svg' and block.settings.icon_svg != blank %}
              {{ block.settings.icon_svg }}
            {% else %}
              <!-- Default SVG Icons -->
              {% assign default_icon = forloop.index0 | modulo: 3 %}
              {% if default_icon == 0 %}
                <!-- Truck / Shipping Icon -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 3h15v13H1z"/>
                  <path d="M16 8h4l3 3v5h-7V8z"/>
                  <circle cx="5.5" cy="18.5" r="2.5"/>
                  <circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
              {% elsif default_icon == 1 %}
                <!-- Returns / Exchange Icon -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 7H4C2.9 7 2 7.9 2 9V19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V9C22 7.9 21.1 22 7 20C21.1 22 20.1 22 19.9 22C18.9 22 18 21.1 18 20C18 18.9 18.9 18 20 18C21.1 18 22 18.9 22 20Z"/>
                </svg>
              {% else %}
                <!-- Appointment / Calendar Icon -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                  <circle cx="12" cy="15" r="1"/>
                  <circle cx="16" cy="15" r="1"/>
                  <circle cx="8" cy="15" r="1"/>
                </svg>
              {% endif %}
            {% endif %}
          </div>
          <div class="feature-title">{{ block.settings.title }}</div>
          <div class="feature-description">{{ block.settings.description }}</div>
          <a href="{{ block.settings.link_url }}" class="feature-link">{{ block.settings.link_text | default: 'Discover More -' }}</a>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "3 Icon Feature Row",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator Line Color",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Icon Settings"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Icon Size (width & height)",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color (for SVG icons only)",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Font Size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Font Size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link Font Size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "limit": 3,
      "settings": [
        {
          "type": "radio",
          "id": "icon_type",
          "label": "Icon Type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "svg",
              "label": "SVG Code"
            },
            {
              "value": "default",
              "label": "Default Icon"
            }
          ],
          "default": "default"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image",
          "info": "Upload an image (PNG, JPG, SVG). Recommended size: 50x50px"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Custom SVG Code",
          "info": "Paste your SVG code here. Only used when 'SVG Code' is selected."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "At your service"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Discover More -"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "3 Icon Feature Row",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Free Shipping",
            "description": "At your service"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Free Returns and Exchange",
            "description": "Easy returns within 30 days"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Book a Private Appointment in Store",
            "description": "Personalized shopping experience"
          }
        }
      ]
    }
  ]
}
{% endschema %}