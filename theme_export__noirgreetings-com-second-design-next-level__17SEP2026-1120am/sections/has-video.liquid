{% style %}
  .aly_vid_container {
    width: 100%;
    height: 500px;
    background-color: aquamarine;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .content_container {
    padding: 50px;
    height: fit-content;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    align-items: {{ section.settings.text_align }} ;
    gap: 20px;
    width: 50%;
    position: absolute; /* Ensure it's positioned relative to the parent container */
    {% case section.settings.overlay_style %}
      {% when 'tint' %}
        background-color: rgb(193 193 193 / 78%);
      {% when 'box' %}
        background: white;
      {% when 'text_shadow' %}
        text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7);
      {% when 'text_shadow_tint' %}
        text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7);
        background-color: rgb(193 193 193 / 78%);
    {% endcase %}
    {% case section.settings.text_position %}
      {% when 'top-center' %}
        top: 0;
        left: 50%;
        transform: translateX(-50%);
      {% when 'top-left' %}
        top: 0;
        left: 0;
      {% when 'top-right' %}
        top: 0;
        right: 0;
      {% when 'middle-center' %}
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      {% when 'middle-right' %}
        top: 50%;
        right: 0;
        transform: translateY(-50%);
      {% when 'middle-left' %}
        top: 50%;
        left: 0;
        transform: translateY(-50%);
      {% when 'bottom-center' %}
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
      {% when 'bottom-left' %}
        bottom: 0;
        left: 0;
      {% when 'bottom-right' %}
        bottom: 0;
        right: 0;
    {% endcase %}
  }
  .background-video {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }
   {% for block in section.blocks %}
  .section-heading-{{ block.id }}{
    margin: 0;
    width: 100%;
    text-align: center;
    max-width: {{ block.settings.heading-max-width }}rem;
    font-size: {{ block.settings.heading-font-s }}px !important;
  }
    .content_container p {
    margin: 0;
    font-size: {{ block.settings.para-font-size }}px;
}
   {% endfor %}
  
  .aly_cnt {
    padding: 0 {% if section.settings.parent_width != true %} 5% {%  else %} 0 {% endif %};
  }
.bg_video_class {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
  @media(max-width:768px) {
    .aly_vid_container {
    width: 100%;
    height: 500px;
    background-color: aquamarine;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
    height: 700px !important;
}
  }
  @media(max-width:550px) {
    .aly_vid_container {
    width: 100%;
    height: 500px;
    background-color: aquamarine;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
    height: 513px !important;
}
     {% for block in section.blocks %}
.section-heading-{{ block.id }}{
    font-size: {{ block.settings.heading-font-s-mob }}px !important;
  }
{% endfor %}
  }
    @media(max-width:400px) {
.aly_vid_container {
    width: 100%;
    height: 500px;
    background-color: aquamarine;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
    height: 389px !important;
}
  }
  @media only screen and (max-width : 425px){
    .content_container {
      width : 85% ;
      padding: 25px;
    }
  }
     .timer {
            font-size: 2rem;
            font-weight: bold;
            animation: fadeIn 1s ease-in-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.8); }
            to { opacity: 1; transform: scale(1); }
        }
        .countdown {
            animation: pulse 1s infinite alternate;
        }
        @keyframes pulse {
            from { transform: scale(1); }
            to { transform: scale(1.1); }
        }
{% endstyle %}
<div class="aly_cnt">
  <div class="aly_vid_container" style="height: {{ section.settings.lg_height }}px;">
    {% if section.settings.background_img != null %}
      <img
        style="
          width: 100%;
          height: 100%;
          object-fit: cover;
        "
        src="https://cdn.shopify.com/s/files/1/0898/0270/3141/files/site_banner_2.webp?v=1731746638"
      >
    {% else %}
      {{
        section.settings.bg_video_dom
        | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, class: 'bg_video_class'
      }}
    {% endif %}
    <div class="content_container">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'sub_heading' %}
            <p>{{ block.settings.sub_heading }}</p>
          {% when 'heading' %}
            <h1 class="section-heading section-heading-{{ block.id }}">{{ block.settings.heading }}</h1>
            {% when 'text' %}
             <p> {{ block.settings.text }} </p>
         
          {% when 'button' %}
            <a class="button button--{{ block.settings.btn_style }}" href="{{ block.settings.button_link }}">
              {{- block.settings.button -}}
            </a>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>
  <script>
        function startCountdown(durationInSeconds) {
            const countdownEl = document.getElementById("countdown");
            
            function updateTimer() {
                let days = Math.floor(durationInSeconds / (60 * 60 * 24));
                let hours = Math.floor((durationInSeconds % (60 * 60 * 24)) / (60 * 60));
                let minutes = Math.floor((durationInSeconds % (60 * 60)) / 60);
                let seconds = durationInSeconds % 60;
                
                countdownEl.textContent = 
                    `${String(days).padStart(2, '0')}:` +
                    `${String(hours).padStart(2, '0')}:` +
                    `${String(minutes).padStart(2, '0')}:` +
                    `${String(seconds).padStart(2, '0')}`;
                
                if (durationInSeconds > 0) {
                    durationInSeconds--;
                    setTimeout(updateTimer, 1000);
                } else {
                    countdownEl.textContent = "Time's Up!";
                    countdownEl.classList.remove("countdown");
                }
            }
            
            updateTimer();
        }
        
        startCountdown(86400); // Set initial countdown duration (e.g., 1 day = 86400 seconds)
    </script>
{% schema %}
{
  "name": "Background Video - Custom",
  "settings": [
    {
      "type": "paragraph",
      "content": "Background videos play on loop, with no sound. If you need a video with sound use the Video section."
    },
    {
      "type": "video",
      "id": "bg_video_dom",
      "label": "Select Video"
    },
    {
      "type": "image_picker",
      "id": "background_img",
      "label": "Custom placeholder image"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Overlay Position",
      "options": [
        { "value": "top-center", "label": "Top Center" },
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "middle-center", "label": "Middle Center" },
        { "value": "middle-right", "label": "Middle Right" },
        { "value": "middle-left", "label": "Middle Left" },
        { "value": "bottom-center", "label": "Bottom Center" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Align",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "End" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "label": "Desktop fixed height",
      "id": "lg_height",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "label": "Mobile fixed height",
      "id": "md_height",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "parent_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        { "value": "tint", "label": "Tint" },
        { "value": "box", "label": "Box" },
        { "value": "text_shadow", "label": "Text Shadow" },
        { "value": "text_shadow_tint", "label": "Text Shadow and Tint" }
      ],
      "default": "box"
    }
  ],
  "blocks": [
    {
      "type": "sub_heading",
      "name": "Sub Heading",
      "settings": [
        {
          "type": "text",
          "id": "sub_heading",
          "label": "Sub Heading",
          "default": "Sub Heading"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "range",
          "min": 4,
          "max": 60,
          "step": 1,
          "unit": "rem",
          "default":35,
          "id": "heading-max-width",
          "label": "Maximum heading width"
        },
        {
          "type": "range",
          "min": 4,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default":40,
          "id": "heading-font-s",
          "label": "Desktop heading text size"
        },
        {
          "type": "range",
          "min": 4,
          "max": 50,
          "step": 1,
          "unit": "px",
          "default":32,
          "id": "heading-font-s-mob",
          "label": "Mobile heading text size"
        },
      ]
    },
     {
      "type": "text",
      "name": "text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Text"
        },
        {
          "type": "range",
          "min": 6,
          "max": 30,
          "unit": "px",
          "step": 1,
          "default":18,
          "id": "para-font-size",
          "label": "Paragraph Font Size"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "button",
          "label": "Button",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "btn_style",
          "label": "Button style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" },
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Background Video - Custom",
      "category": "Video"
    }
  ]
}
{% endschema %}